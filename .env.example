# Etsy API v3 Credentials
# Get your API key from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_etsy_api_key_here

# Optional: your app's shared secret. Some Etsy apps require the x-api-key header
# to be sent as `keystring:shared_secret`; set this if you get 403 errors.
ETSY_SHARED_SECRET=

# OAuth tokens. Recommended: run `npm run auth` once; it writes .etsy-tokens.json
# (access + refresh token) and the server refreshes the access token automatically.
# Alternatively, set a static access token here (expires after ~1 hour).
ETSY_ACCESS_TOKEN=
# Optional: custom location of the token file
# ETSY_TOKEN_FILE=/path/to/.etsy-tokens.json

# Optional: Shop ID for shop-specific default operations
ETSY_SHOP_ID=your_shop_id_here
